<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:contentDescription="@string/pet_widget_description">
    <ViewFlipper
        android:id="@+id/pet_widget_portrait"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="350"
        android:inAnimation="@anim/companion_frame_in"
        android:outAnimation="@anim/companion_frame_out"
        android:visibility="invisible"
        android:contentDescription="@string/pet_widget_description">
        <ImageView android:id="@+id/pet_widget_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="0dp" android:translationY="0dp" android:rotation="0" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-1dp" android:translationY="-1dp" android:rotation="-0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-1dp" android:translationY="-2dp" android:rotation="-1.2" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-2dp" android:translationY="-3dp" android:rotation="-1.5" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-2dp" android:translationY="-4dp" android:rotation="-1.2" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-1dp" android:translationY="-3dp" android:rotation="-0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="0dp" android:translationY="-2dp" android:rotation="0" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="1dp" android:translationY="-1dp" android:rotation="0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="2dp" android:translationY="0dp" android:rotation="1.2" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="2dp" android:translationY="1dp" android:rotation="1.5" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="1dp" android:translationY="1dp" android:rotation="1.2" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_11" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="0dp" android:translationY="0dp" android:rotation="0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_12" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-1dp" android:translationY="-1dp" android:rotation="0" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_13" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting_blink" android:translationX="-1dp" android:translationY="-2dp" android:rotation="-0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_14" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="-1dp" android:translationY="-1dp" android:rotation="-0.6" android:scaleX="0.95" android:scaleY="0.95" />
        <ImageView android:id="@+id/pet_widget_frame_15" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/book_spirit_waiting" android:translationX="0dp" android:translationY="0dp" android:rotation="0" android:scaleX="0.95" android:scaleY="0.95" />
    </ViewFlipper>
</FrameLayout>
